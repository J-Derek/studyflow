rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Data model (every path is owner-only: request.auth.uid == userId)
    //
    // /users/{userId}
    //   uid, name, university, program, semester, updatedAt (server time)
    //   onboarding?: { dismissed: bool }
    //   timerPrefs?: {...}, ageConfirmed?: { band: '13-17' | '18+', guardian: bool, at: string }
    //
    // /users/{userId}/assignments/{id}
    //   id, title, course, dueDate (YYYY-MM-DD), dueTime? (HH:mm), priority,
    //   status, kind? ('assignment'|'exam'|'test'|'reading'|'project'; missing = assignment), progress (0..100), createdAt (client ISO string, immutable),
    //   updatedAt (server time), notes?, completedAt?, sample? (bool),
    //   subtasks? (map keyed by subtask id, or legacy list; max 100)
    //
    // /users/{userId}/semesters/{periodId}
    //   id, name, label ('semester'|'term'|'trimester'), archivedAt (ISO text), counts {assignments, sessions, grades, notes}, updatedAt (server time)
    //   Items archived into it carry archivedPeriod = this id (optional on assignments, sessions, grades, notes). They also carry archived (bool): false for current items, true once archived, so the app can load current items only.
    //
    // /users/{userId}/drafts/{assignmentId}
    //   id (= assignment id), body (Markdown, up to 200000 characters), format ('markdown'), editedAt (ISO text), updatedAt (server time)
    //
    // /users/{userId}/sessions/{id}          (weekly timetable blocks)
    //   id, title, course, dayOfWeek (0..6), startTime, endTime, type,
    //   updatedAt (server time), color?, sample? (bool)
    //
    // /users/{userId}/liveState/timer        (single document)
    //   rev (int, compare-and-swap counter), status ('idle' | 'running' | 'paused'),
    //   mode, durationSeconds, updatedAt (server time),
    //   startedAt (server time; only while running),
    //   remainingSeconds (only while paused)
    //
    // /users/{userId}/grades/{id}
    //   id, courseCode, courseName, credits (0..30), targetLetter, color,
    //   assessments (list, max 50), updatedAt (server time), sample? (bool)
    //
    // /users/{userId}/focusSessions/run-{rev}
    //   Created only in a batch with the timer going running -> idle, and only
    //   after enough server time has elapsed since the timer started.
    //
    // Default: deny everything else.
    // ===============================================================

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function validString(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    function optionalString(data, field, minLen, maxLen) {
      return !(field in data) || validString(data[field], minLen, maxLen);
    }

    function validTime(val) {
      return val is string && val.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$');
    }

    function validDate(val) {
      return val is string && val.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    // Server clock only: serverTimestamp() resolves to request.time.
    function isServerTime(val) {
      return val is timestamp && val == request.time;
    }

    function immutable(fields) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }

    // ---------------- Validators ----------------

    function isValidUser(data, userId) {
      return data.keys().hasAll(['uid', 'name', 'university', 'program', 'semester', 'updatedAt']) &&
             data.keys().hasOnly(['uid', 'name', 'university', 'program', 'semester', 'semesterStart', 'semesterEnd', 'timeZone', 'photo', 'updatedAt', 'onboarding', 'timerPrefs', 'ageConfirmed', 'periodLabel']) &&
             data.uid is string && data.uid == userId &&
             validString(data.name, 1, 100) &&
             validString(data.university, 1, 150) &&
             validString(data.program, 1, 150) &&
             validString(data.semester, 1, 50) &&
             (!('semesterStart' in data) || (data.semesterStart is string && data.semesterStart.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))) &&
             (!('semesterEnd' in data) || (data.semesterEnd is string && data.semesterEnd.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))) &&
             (!('timeZone' in data) || validString(data.timeZone, 1, 64)) &&
             // A small square JPEG the student chose, kept as text (the app resizes it to about 10 KB).
             (!('photo' in data) || (data.photo is string && data.photo.size() <= 60000 && data.photo.matches('data:image/jpeg;base64,.*'))) &&
             isServerTime(data.updatedAt) &&
             (!('onboarding' in data) ||
               (data.onboarding is map &&
                data.onboarding.keys().hasOnly(['dismissed']) &&
                data.onboarding.keys().hasAll(['dismissed']) &&
                data.onboarding.dismissed is bool)) &&
             (!('timerPrefs' in data) || isValidTimerPrefs(data.timerPrefs)) &&
             (!('periodLabel' in data) || data.periodLabel in ['semester', 'term', 'trimester']) &&
             (!('ageConfirmed' in data) || isValidAgeConfirmed(data.ageConfirmed));
    }

    // The age answer given before signing in: a band (never a birth date), whether a parent or guardian agreed, and when.
    // Under 13 is never stored (no account), and 13 to 17 is only valid with the guardian tick.
    function isValidAgeConfirmed(a) {
      return a is map &&
             a.keys().hasOnly(['band', 'guardian', 'at']) &&
             a.keys().hasAll(['band', 'guardian', 'at']) &&
             a.band in ['13-17', '18+'] &&
             a.guardian is bool &&
             (a.band == '18+' || a.guardian == true) &&
             validString(a.at, 10, 40);
    }

    // Timer lengths (seconds) and sounds the student chose. Limits mirror TIMER_LIMITS_MIN in the app:
    // focus up to 180 min, short break 60 min, long break 90 min.
    function isValidTimerPrefs(p) {
      return p is map &&
             p.keys().hasOnly(['focusDuration', 'shortBreakDuration', 'longBreakDuration', 'autoStartBreaks', 'autoStartFocus', 'soundscape', 'breakSoundscape', 'soundscapeVolume']) &&
             p.keys().hasAll(['focusDuration', 'shortBreakDuration', 'longBreakDuration', 'autoStartBreaks', 'autoStartFocus', 'soundscape', 'breakSoundscape', 'soundscapeVolume']) &&
             p.focusDuration is int && p.focusDuration >= 1 && p.focusDuration <= 10800 &&
             p.shortBreakDuration is int && p.shortBreakDuration >= 1 && p.shortBreakDuration <= 3600 &&
             p.longBreakDuration is int && p.longBreakDuration >= 1 && p.longBreakDuration <= 5400 &&
             p.autoStartBreaks is bool && p.autoStartFocus is bool &&
             p.soundscape in ['off', 'rain', 'waves', 'pad', 'keys', 'brown', 'breeze', 'chimes'] &&
             p.breakSoundscape in ['off', 'rain', 'waves', 'pad', 'keys', 'brown', 'breeze', 'chimes'] &&
             p.soundscapeVolume is number && p.soundscapeVolume >= 0 && p.soundscapeVolume <= 1;
    }

    function isValidAssignment(data) {
      return data.keys().hasAll(['id', 'title', 'course', 'dueDate', 'priority', 'status', 'progress', 'createdAt', 'updatedAt']) &&
             data.keys().hasOnly([
               'id', 'title', 'course', 'dueDate', 'dueTime', 'priority', 'status',
               'progress', 'notes', 'subtasks', 'createdAt', 'completedAt', 'updatedAt', 'sample', 'kind', 'archivedPeriod', 'archived'
             ]) &&
             optionalString(data, 'archivedPeriod', 1, 60) &&
             (!('archived' in data) || data.archived is bool) &&
             validString(data.id, 1, 100) &&
             validString(data.title, 1, 250) &&
             validString(data.course, 1, 200) &&
             (!('kind' in data) || data.kind in ['assignment', 'exam', 'test', 'reading', 'project']) &&
             validDate(data.dueDate) &&
             (!('dueTime' in data) || validTime(data.dueTime)) &&
             data.priority in ['low', 'medium', 'high'] &&
             data.status in ['pending', 'in_progress', 'completed'] &&
             data.progress is number && data.progress >= 0 && data.progress <= 100 &&
             (data.status != 'completed' || data.progress == 100) &&
             optionalString(data, 'notes', 0, 5000) &&
             (!('subtasks' in data) ||
               (data.subtasks is map && data.subtasks.size() <= 100) ||
               (data.subtasks is list && data.subtasks.size() <= 100)) &&
             validString(data.createdAt, 1, 50) &&
             optionalString(data, 'completedAt', 0, 50) &&
             (!('sample' in data) || data.sample is bool) &&
             isServerTime(data.updatedAt);
    }

    // The text a student writes for one assignment in the writing space. The document id is the assignment's id.
    function isValidDraft(data) {
      return data.keys().hasAll(['id', 'body', 'format', 'editedAt', 'updatedAt']) &&
             data.keys().hasOnly(['id', 'body', 'format', 'editedAt', 'updatedAt']) &&
             validString(data.id, 1, 100) &&
             data.body is string && data.body.size() <= 200000 &&
             data.format == 'markdown' &&
             validString(data.editedAt, 1, 50) &&
             isServerTime(data.updatedAt);
    }

    // A past semester or term the student archived. Its items carry `archivedPeriod` = this document's id.
    function isValidPeriod(data) {
      return data.keys().hasAll(['id', 'name', 'label', 'archivedAt', 'counts', 'updatedAt']) &&
             data.keys().hasOnly(['id', 'name', 'label', 'archivedAt', 'counts', 'updatedAt']) &&
             validString(data.id, 1, 60) &&
             validString(data.name, 1, 100) &&
             data.label in ['semester', 'term', 'trimester'] &&
             validString(data.archivedAt, 1, 50) &&
             data.counts is map &&
             data.counts.keys().hasOnly(['assignments', 'sessions', 'grades', 'notes']) &&
             data.counts.keys().hasAll(['assignments', 'sessions', 'grades', 'notes']) &&
             data.counts.assignments is int && data.counts.assignments >= 0 && data.counts.assignments <= 5000 &&
             data.counts.sessions is int && data.counts.sessions >= 0 && data.counts.sessions <= 5000 &&
             data.counts.grades is int && data.counts.grades >= 0 && data.counts.grades <= 5000 &&
             data.counts.notes is int && data.counts.notes >= 0 && data.counts.notes <= 5000 &&
             isServerTime(data.updatedAt);
    }

    function isValidNote(data) {
      return data.keys().hasAll(['id', 'title', 'body', 'course', 'pinned', 'createdAt', 'editedAt', 'updatedAt']) &&
             data.keys().hasOnly(['id', 'title', 'body', 'course', 'pinned', 'createdAt', 'editedAt', 'updatedAt', 'archivedPeriod', 'archived']) &&
             optionalString(data, 'archivedPeriod', 1, 60) &&
             (!('archived' in data) || data.archived is bool) &&
             validString(data.id, 1, 100) &&
             validString(data.title, 1, 200) &&
             data.body is string && data.body.size() <= 20000 &&
             data.course is string && data.course.size() <= 50 &&
             data.pinned is bool &&
             validString(data.createdAt, 1, 50) &&
             validString(data.editedAt, 1, 50) &&
             isServerTime(data.updatedAt);
    }

    function isValidSession(data) {
      return data.keys().hasAll(['id', 'title', 'course', 'dayOfWeek', 'startTime', 'endTime', 'type', 'updatedAt']) &&
             data.keys().hasOnly([
               'id', 'title', 'course', 'dayOfWeek', 'startTime', 'endTime', 'type', 'color', 'updatedAt', 'sample', 'archivedPeriod', 'archived'
             ]) &&
             optionalString(data, 'archivedPeriod', 1, 60) &&
             (!('archived' in data) || data.archived is bool) &&
             validString(data.id, 1, 100) &&
             validString(data.title, 1, 200) &&
             validString(data.course, 1, 200) &&
             data.dayOfWeek is int && data.dayOfWeek >= 0 && data.dayOfWeek <= 6 &&
             validTime(data.startTime) &&
             validTime(data.endTime) &&
             data.type in ['lecture', 'lab', 'study', 'review', 'exam'] &&
             optionalString(data, 'color', 0, 50) &&
             (!('sample' in data) || data.sample is bool) &&
             isServerTime(data.updatedAt);
    }

    function isValidGrade(data) {
      return data.keys().hasAll(['id', 'courseCode', 'courseName', 'credits', 'targetLetter', 'color', 'assessments', 'updatedAt']) &&
             data.keys().hasOnly(['id', 'courseCode', 'courseName', 'credits', 'targetLetter', 'color', 'assessments', 'updatedAt', 'sample', 'archivedPeriod', 'archived']) &&
             optionalString(data, 'archivedPeriod', 1, 60) &&
             (!('archived' in data) || data.archived is bool) &&
             validString(data.id, 1, 100) &&
             validString(data.courseCode, 1, 50) &&
             validString(data.courseName, 1, 200) &&
             data.credits is number && data.credits >= 0 && data.credits <= 30 &&
             validString(data.targetLetter, 1, 3) &&
             validString(data.color, 1, 50) &&
             data.assessments is list && data.assessments.size() <= 50 &&
             (!('sample' in data) || data.sample is bool) &&
             isServerTime(data.updatedAt);
    }

    function isValidTimer(data) {
      return data.keys().hasAll(['rev', 'status', 'mode', 'durationSeconds', 'updatedAt']) &&
             data.keys().hasOnly(['rev', 'status', 'mode', 'durationSeconds', 'updatedAt', 'startedAt', 'remainingSeconds']) &&
             data.rev is int && data.rev >= 1 &&
             data.status in ['idle', 'running', 'paused'] &&
             data.mode in ['focus', 'shortBreak', 'longBreak'] &&
             data.durationSeconds is int && data.durationSeconds >= 1 && data.durationSeconds <= 86400 &&
             isServerTime(data.updatedAt) &&
             (data.status == 'running'
               ? (isServerTime(data.get('startedAt', null)) && !('remainingSeconds' in data))
               : !('startedAt' in data)) &&
             (data.status == 'paused'
               ? (data.get('remainingSeconds', -1) is int && data.remainingSeconds >= 0 && data.remainingSeconds <= data.durationSeconds)
               : !('remainingSeconds' in data));
    }

    function timerPath(userId) {
      return /databases/$(database)/documents/users/$(userId)/liveState/timer;
    }

    function isValidFocusSession(data, userId, sessionId) {
      let timer = get(timerPath(userId)).data;
      let after = getAfter(timerPath(userId)).data;
      return data.keys().hasAll(['durationSeconds', 'mode', 'completedAt', 'localDate']) &&
             data.keys().hasOnly(['durationSeconds', 'mode', 'completedAt', 'localDate', 'assignmentId', 'notes']) &&
             timer.status == 'running' &&
             timer.mode == 'focus' &&
             data.mode == 'focus' &&
             sessionId == 'run-' + string(timer.rev) &&
             data.durationSeconds is int && data.durationSeconds >= 1 &&
             data.durationSeconds <= timer.durationSeconds &&
             data.durationSeconds <= (request.time - timer.startedAt).seconds() + 2 &&
             isServerTime(data.completedAt) &&
             validDate(data.localDate) &&
             optionalString(data, 'assignmentId', 1, 100) &&
             optionalString(data, 'notes', 0, 2000) &&
             after.status == 'idle' && after.rev == timer.rev + 1;
    }

    // ---------------- Collections ----------------

    match /users/{userId} {
      allow get, delete: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && isValidUser(request.resource.data, userId);
      allow update: if isOwner(userId) &&
                       isValidUser(request.resource.data, userId) &&
                       immutable(['uid']);

      match /assignments/{assignmentId} {
        allow get: if isOwner(userId);
        allow list: if isOwner(userId) && request.query.limit <= 500;
        allow create: if isOwner(userId) &&
                         isValidAssignment(request.resource.data) &&
                         request.resource.data.id == assignmentId;
        allow update: if isOwner(userId) &&
                         isValidAssignment(request.resource.data) &&
                         immutable(['id', 'createdAt']);
        allow delete: if isOwner(userId);
      }

      match /notes/{noteId} {
        allow get: if isOwner(userId);
        allow list: if isOwner(userId) && request.query.limit <= 500;
        allow create: if isOwner(userId) &&
                         isValidNote(request.resource.data) &&
                         request.resource.data.id == noteId;
        allow update: if isOwner(userId) &&
                         isValidNote(request.resource.data) &&
                         immutable(['id', 'createdAt']);
        allow delete: if isOwner(userId);
      }

      match /semesters/{periodId} {
        allow get: if isOwner(userId);
        allow list: if isOwner(userId) && request.query.limit <= 500;
        allow create: if isOwner(userId) &&
                         isValidPeriod(request.resource.data) &&
                         request.resource.data.id == periodId;
        allow update: if isOwner(userId) &&
                         isValidPeriod(request.resource.data) &&
                         immutable(['id']);
        allow delete: if isOwner(userId);
      }

      match /drafts/{draftId} {
        allow get: if isOwner(userId);
        allow list: if isOwner(userId) && request.query.limit <= 500;
        allow create: if isOwner(userId) &&
                         isValidDraft(request.resource.data) &&
                         request.resource.data.id == draftId;
        allow update: if isOwner(userId) &&
                         isValidDraft(request.resource.data) &&
                         immutable(['id']);
        allow delete: if isOwner(userId);
      }

      match /sessions/{sessionId} {
        allow get: if isOwner(userId);
        allow list: if isOwner(userId) && request.query.limit <= 500;
        allow create: if isOwner(userId) &&
                         isValidSession(request.resource.data) &&
                         request.resource.data.id == sessionId;
        allow update: if isOwner(userId) &&
                         isValidSession(request.resource.data) &&
                         immutable(['id']);
        allow delete: if isOwner(userId);
      }

      match /grades/{gradeId} {
        allow get: if isOwner(userId);
        allow list: if isOwner(userId) && request.query.limit <= 500;
        allow create: if isOwner(userId) &&
                         isValidGrade(request.resource.data) &&
                         request.resource.data.id == gradeId;
        allow update: if isOwner(userId) &&
                         isValidGrade(request.resource.data) &&
                         immutable(['id']);
        allow delete: if isOwner(userId);
      }

      match /focusSessions/{sessionId} {
        allow get: if isOwner(userId);
        allow list: if isOwner(userId) && request.query.limit <= 500;
        allow create: if isOwner(userId) && isValidFocusSession(request.resource.data, userId, sessionId);
        allow update: if false;
        allow delete: if isOwner(userId);
      }

      // Timer singleton with a rev counter used as compare-and-swap.
      match /liveState/{docId} {
        allow get: if isOwner(userId);
        allow create: if isOwner(userId) && docId == 'timer' &&
                         isValidTimer(request.resource.data) &&
                         request.resource.data.rev == 1;
        allow update: if isOwner(userId) && docId == 'timer' &&
                         isValidTimer(request.resource.data) &&
                         request.resource.data.rev == resource.data.rev + 1;
        allow delete: if isOwner(userId);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
