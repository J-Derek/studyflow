{
  "name": "app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "vitest run",
    "preview": "vite preview",
    "test:rules": "firebase emulators:exec --config ../firebase.json --only firestore --project studyflow-rules-test \"vitest run --config vitest.rules.config.ts\"",
    "test:e2e": "firebase emulators:exec --config ../firebase.json --only auth,firestore --project studyflow-e2e \"playwright test\"",
    "test:e2e:prod": "firebase emulators:exec --config ../firebase.json --only auth,firestore --project studyflow-e2e \"playwright test --config playwright.prod.config.ts\""
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "firebase": "^13.1.0",
    "lucide-react": "^1.66.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.64.1",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.2",
    "firebase-tools": "^15.35.0",
    "ical.js": "^2.2.1",
    "oxlint": "^1.89.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.17",
    "typescript": "~7.0.2",
    "vercel": "^65.10.0",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
